#!/bin/bash

# PHP 8.3.0 Migration Script
# This script backs up current PHP extensions, installs PHP 8.3, reinstalls extensions, and updates alternatives

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if running as root
if [ "$EUID" -ne 0 ]; then 
    echo -e "${RED}Please run as root or with sudo${NC}"
    exit 1
fi

echo -e "${GREEN}=== PHP 8.3.0 Migration Script ===${NC}\n"

# Detect current PHP version
CURRENT_PHP=$(php -r "echo PHP_VERSION;" 2>/dev/null || echo "none")
echo -e "${YELLOW}Current PHP version: ${CURRENT_PHP}${NC}\n"

# Get current PHP version number (e.g., 7.4, 8.1, etc.)
if [ "$CURRENT_PHP" != "none" ]; then
    CURRENT_PHP_VERSION=$(php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;" 2>/dev/null)
else
    CURRENT_PHP_VERSION="none"
    echo -e "${YELLOW}No PHP installation detected${NC}"
fi

# Store installed extensions
EXTENSIONS_FILE="/tmp/php_extensions_backup.txt"
echo -e "${YELLOW}Checking installed PHP extensions...${NC}"

if [ "$CURRENT_PHP" != "none" ]; then
    php -m | grep -v "\[" | grep -v "^$" | sort > "$EXTENSIONS_FILE"
    echo -e "${GREEN}Found $(wc -l < $EXTENSIONS_FILE) extensions${NC}"
    echo "Extensions saved to: $EXTENSIONS_FILE"
    cat "$EXTENSIONS_FILE"
    echo ""
else
    touch "$EXTENSIONS_FILE"
    echo -e "${YELLOW}No extensions to backup${NC}\n"
fi

# Add PHP repository (ondrej/php for Ubuntu/Debian)
echo -e "${YELLOW}Adding PHP repository...${NC}"
if command -v add-apt-repository &> /dev/null; then
    apt-get update
    apt-get install -y software-properties-common
    add-apt-repository ppa:ondrej/php -y
    apt-get update
else
    echo -e "${RED}add-apt-repository not found. Please add PHP 8.3 repository manually${NC}"
    exit 1
fi

# Install PHP 8.3 and common packages
echo -e "\n${YELLOW}Installing PHP 8.3...${NC}"
apt-get install -y php8.3 php8.3-cli php8.3-common php8.3-fpm php8.3-phar

# Map common extension names to package names
declare -A EXTENSION_MAP=(
    ["curl"]="php8.3-curl"
    ["gd"]="php8.3-gd"
    ["mbstring"]="php8.3-mbstring"
    ["mysql"]="php8.3-mysql"
    ["mysqli"]="php8.3-mysql"
    ["pdo_mysql"]="php8.3-mysql"
    ["xml"]="php8.3-xml"
    ["zip"]="php8.3-zip"
    ["bcmath"]="php8.3-bcmath"
    ["bz2"]="php8.3-bz2"
    ["intl"]="php8.3-intl"
    ["soap"]="php8.3-soap"
    ["xsl"]="php8.3-xsl"
    ["pgsql"]="php8.3-pgsql"
    ["pdo_pgsql"]="php8.3-pgsql"
    ["sqlite3"]="php8.3-sqlite3"
    ["pdo_sqlite"]="php8.3-sqlite3"
    ["redis"]="php8.3-redis"
    ["memcached"]="php8.3-memcached"
    ["imagick"]="php8.3-imagick"
    ["gmp"]="php8.3-gmp"
    ["imap"]="php8.3-imap"
    ["ldap"]="php8.3-ldap"
    ["opcache"]="php8.3-opcache"
    ["readline"]="php8.3-readline"
    ["tidy"]="php8.3-tidy"
    ["xmlrpc"]="php8.3-xmlrpc"
    ["enchant"]="php8.3-enchant"
    ["snmp"]="php8.3-snmp"
    ["pspell"]="php8.3-pspell"
)

# Core extensions that don't need separate installation
CORE_EXTENSIONS="Core|date|filter|hash|json|libxml|openssl|pcre|Phar|Reflection|session|SPL|standard|tokenizer|zlib|ctype|fileinfo|PDO|Zend OPcache|pcntl|posix|shmop|sysvmsg|sysvsem|sysvshm"

# Install extensions
echo -e "\n${YELLOW}Installing PHP 8.3 extensions...${NC}"
PACKAGES_TO_INSTALL=()

while IFS= read -r ext; do
    # Skip core extensions
    if echo "$ext" | grep -qE "^($CORE_EXTENSIONS)$"; then
        continue
    fi
    
    # Check if we have a mapping for this extension
    if [ -n "${EXTENSION_MAP[$ext]}" ]; then
        PACKAGE="${EXTENSION_MAP[$ext]}"
        if ! echo "${PACKAGES_TO_INSTALL[@]}" | grep -q "$PACKAGE"; then
            PACKAGES_TO_INSTALL+=("$PACKAGE")
        fi
    else
        # Try generic package name
        GENERIC_PACKAGE="php8.3-$ext"
        if apt-cache show "$GENERIC_PACKAGE" &> /dev/null; then
            if ! echo "${PACKAGES_TO_INSTALL[@]}" | grep -q "$GENERIC_PACKAGE"; then
                PACKAGES_TO_INSTALL+=("$GENERIC_PACKAGE")
            fi
        else
            echo -e "${YELLOW}Warning: No package found for extension: $ext${NC}"
        fi
    fi
done < "$EXTENSIONS_FILE"

# Install all packages
if [ ${#PACKAGES_TO_INSTALL[@]} -gt 0 ]; then
    echo -e "${GREEN}Installing packages: ${PACKAGES_TO_INSTALL[*]}${NC}"
    apt-get install -y "${PACKAGES_TO_INSTALL[@]}" || echo -e "${YELLOW}Some packages failed to install${NC}"
else
    echo -e "${YELLOW}No additional packages to install${NC}"
fi

# Update alternatives
echo -e "\n${YELLOW}Updating alternatives system...${NC}"

# Update php alternative
if [ -f /usr/bin/php8.3 ]; then
    update-alternatives --set php /usr/bin/php8.3 2>/dev/null || update-alternatives --install /usr/bin/php php /usr/bin/php8.3 83
    echo -e "${GREEN}✓ Updated php alternative${NC}"
fi

# Update phar alternative
if [ -f /usr/bin/phar8.3 ]; then
    update-alternatives --set phar /usr/bin/phar8.3 2>/dev/null || update-alternatives --install /usr/bin/phar phar /usr/bin/phar8.3 83
    echo -e "${GREEN}✓ Updated phar alternative${NC}"
fi

# Update phar.phar alternative
if [ -f /usr/bin/phar.phar8.3 ]; then
    update-alternatives --set phar.phar /usr/bin/phar.phar8.3 2>/dev/null || update-alternatives --install /usr/bin/phar.phar phar.phar /usr/bin/phar.phar8.3 83
    echo -e "${GREEN}✓ Updated phar.phar alternative${NC}"
fi

# Update phpize alternative (requires php8.3-dev)
if [ -f /usr/bin/phpize8.3 ]; then
    update-alternatives --set phpize /usr/bin/phpize8.3 2>/dev/null || update-alternatives --install /usr/bin/phpize phpize /usr/bin/phpize8.3 83
    echo -e "${GREEN}✓ Updated phpize alternative${NC}"
else
    echo -e "${YELLOW}⚠ phpize8.3 not found (install php8.3-dev if needed)${NC}"
fi

# Update php-config alternative (requires php8.3-dev)
if [ -f /usr/bin/php-config8.3 ]; then
    update-alternatives --set php-config /usr/bin/php-config8.3 2>/dev/null || update-alternatives --install /usr/bin/php-config php-config /usr/bin/php-config8.3 83
    echo -e "${GREEN}✓ Updated php-config alternative${NC}"
else
    echo -e "${YELLOW}⚠ php-config8.3 not found (install php8.3-dev if needed)${NC}"
fi

echo -e "${GREEN}Alternatives update complete${NC}"

# Verify installation
echo -e "\n${YELLOW}Verifying PHP 8.3 installation...${NC}"
NEW_PHP_VERSION=$(php -v | head -n 1)
echo -e "${GREEN}$NEW_PHP_VERSION${NC}\n"

# Compare extensions
echo -e "${YELLOW}Comparing installed extensions...${NC}"
php -m | grep -v "\[" | grep -v "^$" | sort > /tmp/php83_extensions.txt

echo -e "\n${GREEN}=== Migration Complete ===${NC}"
echo -e "${YELLOW}Original extensions count:${NC} $(wc -l < $EXTENSIONS_FILE)"
echo -e "${YELLOW}New extensions count:${NC} $(wc -l < /tmp/php83_extensions.txt)"

# Show differences
echo -e "\n${YELLOW}Extensions in original but missing in PHP 8.3:${NC}"
comm -23 "$EXTENSIONS_FILE" /tmp/php83_extensions.txt | sed 's/^/  - /' || echo "  None"

echo -e "\n${YELLOW}New extensions in PHP 8.3:${NC}"
comm -13 "$EXTENSIONS_FILE" /tmp/php83_extensions.txt | sed 's/^/  + /' || echo "  None"

# Restart services if needed
if systemctl list-units --type=service | grep -q php.*fpm; then
    echo -e "\n${YELLOW}Restarting PHP-FPM services...${NC}"
    systemctl restart php8.3-fpm 2>/dev/null && echo -e "${GREEN}PHP 8.3 FPM restarted${NC}" || true
    
    if [ "$CURRENT_PHP_VERSION" != "none" ] && [ "$CURRENT_PHP_VERSION" != "8.3" ]; then
        systemctl stop php${CURRENT_PHP_VERSION}-fpm 2>/dev/null && echo -e "${YELLOW}PHP $CURRENT_PHP_VERSION FPM stopped${NC}" || true
    fi
fi

echo -e "\n${GREEN}Done! PHP 8.3.0 is now active${NC}"
echo -e "${YELLOW}Note: You may need to restart your web server (Apache/Nginx)${NC}"
